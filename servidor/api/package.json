{
  "name": "finaquick-servidor",
  "private": true,
  "version": "1.0.0",
  "description": "Backend propio de Finaquick: Node.js + Express + PostgreSQL directo, sin depender de ningún servicio de terceros.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "respaldar": "node scripts/respaldar-bd.js",
    "demo": "node scripts/cargar-demo.js",
    "demo:vivo": "tsx scripts/demo-vivo.ts",
    "test": "tsx --test --experimental-test-coverage --test-concurrency=1 test/*.test.ts",
    "carga": "tsx scripts/prueba-de-carga.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^13.5.0",
    "pg": "^8.13.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
