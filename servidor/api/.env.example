DATABASE_URL=postgresql://finaquick_app:cambia-esta-contrasena@localhost:5432/finaquick
# Rol APARTE del de arriba, solo para respaldos (scripts/respaldar-bd.js)
# — finaquick_app no puede ver todo (RLS de por medio, a propósito),
# así que un respaldo con ese rol quedaría incompleto sin avisar.
# finaquick_respaldo tiene BYPASSRLS y nada más — ver esquema_local.sql.
DATABASE_URL_RESPALDO=postgresql://finaquick_respaldo:cambia-esta-contrasena@localhost:5432/finaquick
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
PORT=4000
# Cuántas conexiones a la base de datos puede tener abiertas el
# servidor al mismo tiempo. 20 alcanza cómodamente para un campus; si
# de verdad esperas varias decenas de personas conectadas a la vez,
# puedes subirlo — PostgreSQL admite bastantes más sin problema (100
# por default). Ver PRUEBA_DE_CARGA.md para cómo se llegó a este
# número y cómo medirlo tú mismo con tu propio hardware.
DB_POOL_MAX=20
# Origen exacto desde el que corre el frontend — el servidor rechaza
# peticiones de cualquier otro origen. Varios separados por coma si
# hace falta (ej. desarrollo + producción).
ORIGEN_PERMITIDO=http://localhost:5173
# Dirección pública del frontend — a donde Microsoft redirige de vuelta
# después de iniciar sesión.
FRONTEND_URL=http://localhost:5173
# Pon esto en "true" solo cuando el sitio ya corre detrás de HTTPS real
# (producción) — hace que la cookie de sesión solo viaje cifrada. En
# local (http://localhost), déjalo sin poner.
COOKIE_SECURE=
# Pon esto SOLO si de verdad corre detrás de un proxy/balanceador
# (nginx, un load balancer) — con el número de saltos de proxy que
# haya delante (normalmente 1). Sin esto, el límite de intentos de
# login identifica a cada usuario por la IP del proxy, no la suya real.
# En local, o corriendo directo sin proxy, déjalo sin poner.
TRUST_PROXY=

# Inicio de sesión con la cuenta institucional de Microsoft — opcional,
# sin esto el botón de "Microsoft" simplemente no aparece. Se obtienen
# registrando una app en Microsoft Entra ID (antes Azure AD), del lado
# de la institución — ver LOCAL_SETUP.md.
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
MICROSOFT_REDIRECT_URI=http://localhost:4000/api/auth/microsoft/callback

# Envío de correo (confirmar cuenta, recuperar contraseña, avisar
# cuando llega un archivo) — opcional, reutiliza el MISMO registro de
# aplicación de arriba (MICROSOFT_CLIENT_ID/SECRET/TENANT_ID), solo
# hace falta agregarle el permiso de aplicación "Mail.Send" en
# Microsoft Entra ID y poner aquí el buzón desde el que se manda. Sin
# esto, la app funciona igual pero sin mandar ningún correo.
MICROSOFT_CORREO_ENVIO=

# Búsqueda en lenguaje natural de Quick (el ícono junto a la campana)
# — opcional, sin esto sigue funcionando por patrones normales (fechas,
# nombres, "resumen de tal mes"), solo que entiende menos formas de
# preguntar. Requiere una cuenta y una clave de API PROPIA de Google
# (o tuya, mientras pruebas) — Gemini ofrece un nivel gratuito para
# este tipo de uso ligero, sin tarjeta (revisa las condiciones
# vigentes en ai.google.dev). GEMINI_API_KEY nunca la compartas ni la
# subas a git — este archivo ya está en .gitignore. GEMINI_MODELO es
# opcional y conviene dejarlo vacío: así se usa automáticamente el
# modelo Flash más reciente que tu clave tenga disponible.
GEMINI_API_KEY=
GEMINI_MODELO=
